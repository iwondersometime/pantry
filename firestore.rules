rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Test document check for connection verification
    match /test/{testId} {
      allow read: if true;
    }

    // User data is strictly isolated to the authenticated user's own UID
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /{allPaths=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
